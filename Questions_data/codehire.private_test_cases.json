{
  "_id": "69da7c1aa87a01aa6a2be89e",
  "problem_id": "18",
  "problem_slug": "4sum",
  "hidden_test_cases": [
    {
      "input": "1000000000 1000000000 1000000000 1000000000\n0",
      "expected_output": "[]\n"
    },
    {
      "input": "1000000000 1000000000 1000000000 1000000000\n4000000000",
      "expected_output": "[[1000000000,1000000000,1000000000,1000000000]]\n"
    },
    {
      "input": "0 0 0 0\n0",
      "expected_output": "[[0,0,0,0]]\n"
    },
    {
      "input": "-3 -2 -1 0 0 1 2 3\n0",
      "expected_output": "[[-3,-2,2,3],[-3,-1,1,3],[-3,0,0,3],[-3,0,1,2],[-2,-1,0,3],[-2,-1,1,2],[-2,0,0,2],[-1,0,0,1]]\n"
    },
    {
      "input": "-5 5 4 -3 0 0 4 -2\n4",
      "expected_output": "[[-5,0,4,5],[-3,-2,4,5],[-2,0,2,4]]\n"
    },
    {
      "input": "1 2 3\n6",
      "expected_output": "[]\n"
    },
    {
      "input": "-1000000000 -1000000000 -1000000000 -1000000000\n-4000000000",
      "expected_output": "[[-1000000000,-1000000000,-1000000000,-1000000000]]\n"
    },
    {
      "input": "2 2 2 2 2 2 2 2 2 2\n8",
      "expected_output": "[[2,2,2,2]]\n"
    },
    {
      "input": "1 -2 -5 -4 -3 3 3 5\n-11",
      "expected_output": "[[-5,-4,-3,1]]\n"
    },
    {
      "input": "0 0 0 0 0 0 0\n0",
      "expected_output": "[[0,0,0,0]]\n"
    }
  ]
},
